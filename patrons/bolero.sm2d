<?xml version="1.0" encoding="UTF-8"?>
<pattern>
<!--Généré par un script (fil Bases chaîne et trame femme), puis modifiable dans Seamly2D.-->
<version>0.7.4</version><unit>cm</unit><description/><notes/><patternLabel><line alignment="1" bold="true" italic="false" sfIncrement="3" text="BOLÉRO"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="T%size%"/><line alignment="4" bold="false" italic="false" sfIncrement="0" text="%pName%"/></patternLabel><measurements>../mesures/femme/T38.smms</measurements><variables><variable description="Aisance de construction sur 1/2 tour de hanches (AB), livre p. 62" formula="3" name="#constr_hanches"/>
<variable description="Ligne de petites hanches sous la taille (EG), livre p. 62" formula="9" name="#petites_hanches"/>
<variable description="1re pince dos, milieu dos (tableau des pinces, p. 64)" formula="1" name="#pince_dos1"/>
<variable description="2e pince dos (p. 64)" formula="3" name="#pince_dos2"/>
<variable description="3e pince dos (p. 64)" formula="1" name="#pince_dos3"/>
<variable description="1re pince devant (p. 64)" formula="3" name="#pince_dev1"/>
<variable description="2e pince devant (p. 64)" formula="2" name="#pince_dev2"/>
<variable description="Total des pinces de taille (10 cm)" formula="#pince_dos1+#pince_dos2+#pince_dos3+#pince_dev1+#pince_dev2" name="#pinces"/>
<variable description="Pince d'omoplate (exemple D2L3 = 12 + 1, p. 64)" formula="1" name="#pince_omoplate"/>
<variable description="L4 remonté au-dessus de la ligne d'épaule (annotation du tome 1, confirmée par Thomas)" formula="0.5" name="#remonte_L4"/>
<variable description="Centre Q de la 2e pince dos depuis F1 (p. 66)" formula="8.5" name="#pos_pince_dos"/>
<variable description="Longueur de la pince d'omoplate D3Z (p. 66)" formula="7" name="#long_pince_omoplate"/>
<variable description="V1 au-dessus de la ligne de grandes hanches (p. 66)" formula="9" name="#pointe_dos"/>
<variable description="e au-dessus de la ligne de grandes hanches (p. 68)" formula="6" name="#pointe_dev"/>
<variable description="P3 : pointe de la pince de poitrine, 2 cm au-dessus de P (p. 68)" formula="2" name="#remonte_P"/>
<variable description="E4 : pointe de la 1re pince devant, 2 cm sous P (p. 68)" formula="2" name="#descente_E4"/>
<variable description="Platitude du dessous d'emmanchure devant (p. 68)" formula="2" name="#plat_emm_dev"/>
<variable description="Platitude du dessous d'emmanchure dos (p. 68)" formula="1" name="#plat_emm_dos"/>
<variable description="Platitude de l'encolure au milieu dos (p. 68)" formula="2" name="#plat_enc_dos"/>
<variable description="Platitude de l'encolure au milieu devant (p. 68)" formula="1" name="#plat_enc_dev"/>
<variable description="Fond tailleur : milieu devant descendu (p. 78)" formula="2" name="#t_enc_dev"/>
<variable description="Fond tailleur : milieu dos descendu (p. 78)" formula="0.1" name="#t_enc_dos"/>
<variable description="Fond tailleur : encolure ouverte sur l'épaule (p. 78)" formula="0.6" name="#t_ouv_epaule"/>
<variable description="Fond tailleur : longueur d'épaule allongée (p. 78)" formula="0.5" name="#t_allong_epaule"/>
<variable description="Fond tailleur : carrure devant (p. 78)" formula="0.5" name="#t_carrure_dev"/>
<variable description="Fond tailleur : carrure dos (p. 78)" formula="1" name="#t_carrure_dos"/>
<variable description="Fond tailleur : dessous de bras élargi (p. 78)" formula="2" name="#t_dessous_bras"/>
<variable description="Fond tailleur : dessous de bras descendu (p. 78)" formula="1.75" name="#t_descente_bras"/>
<variable description="Fond tailleur : taille élargie (p. 78)" formula="1.25" name="#t_taille"/>
<variable description="Fond tailleur : hanches élargies (p. 78)" formula="1.5" name="#t_hanches"/>
<variable description="Hauteur d'épaulette : boléro sans épaulette (Thomas, 2026-10-27)" formula="0" name="#epaulette"/>
<variable description="Longueur de manche (tableau ligne 15)" formula="arm_shoulder_tip_to_wrist" name="#long_manche"/>
<variable description="Hauteur de coude AD (livre : 35 cm ; tableau ligne 17)" formula="35" name="#haut_coude"/>
<variable description="Largeur du bas de manche (exemple du livre : 24 cm)" formula="24" name="#bas_manche"/>
<variable description="JK = J'K' : 0,5 cm, à régler selon l'embu (livre p. 150)" formula="0.5" name="#m_JK"/>
<variable description="HL : 5 cm, à régler (livre p. 150)" formula="5" name="#m_HL"/>
<variable description="IT : 1 à 1,5 cm (livre), milieu de la fourchette" formula="1.25" name="#m_IT"/>
<variable description="Boléro : longueur sous le dessous de bras du fond tailleur (choix de modèle, ~8-10 cm)" formula="9" name="#bolero_sous_bras"/>
<variable description="Col officier : hauteur AD (exemple du livre, tome 1)" formula="3" name="#col_hauteur"/>
<variable description="Boléro : rayon de l'arrondi du bas devant (choix de modèle)" formula="6" name="#bolero_arrondi"/></variables>

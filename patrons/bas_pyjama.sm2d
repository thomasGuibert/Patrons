    <patternLabel>
        <line alignment="1" bold="true" italic="false" sfIncrement="3" text="BAS DE PYJAMA"/>
        <line alignment="4" bold="false" italic="true" sfIncrement="0" text="Pantalon souple"/>
        <line alignment="4" bold="false" italic="true" sfIncrement="0" text="T%size%"/>
        <line alignment="4" bold="false" italic="false" sfIncrement="0" text="%pName%"/>
    </patternLabel>
    <measurements>../mesures/T44.smms</measurements>
    <variables>
        <variable description="Aisance au tour de taille (p. 238)" formula="4" name="#aisance_taille"/>
        <variable description="Taille descendue sous la taille morphologique (p. 238)" formula="4" name="#descente_taille"/>
        <variable description="Aisance au tour de hanches (p. 238)" formula="2" name="#aisance_hanches"/>
        <variable description="Tour de taille avec aisance" formula="waist_circ + #aisance_taille" name="#taille_ais"/>
        <variable description="Tour de hanches avec aisance" formula="hip_circ + #aisance_hanches" name="#hanches_ais"/>
        <variable description="Espace entre le bas du pantalon et le sol" formula="12" name="#garde_sol"/>
        <variable description="Hauteur totale du pantalon AE" formula="height_waist_side - #garde_sol" name="#haut_pantalon"/>
        <variable description="Largeur du genou (valeur de mode, p. 238)" formula="48" name="#larg_genou"/>
        <variable description="Largeur du bas de pantalon (valeur de mode, p. 238)" formula="40" name="#larg_bas_pant"/>
        <variable description="Élargissement de la pointe d'enfourchure vers l'entrejambe (p. 244 : 1 à 2,5)" formula="2" name="#el_enf_h"/>
        <variable description="Descente de la pointe d'enfourchure (p. 244 : 1 à 3)" formula="2" name="#el_enf_v"/>
        <variable description="Élargissement de la taille au côté (p. 245)" formula="0.5" name="#el_taille_cote"/>
        <variable description="Élargissement A : côté au montant (p. 245, valeur choisie)" formula="1.5" name="#el_A"/>
        <variable description="Élargissement B : genou, côté et entrejambe (p. 245, valeur choisie)" formula="1.5" name="#el_B"/>
        <variable description="Élargissement C : bas, côté et entrejambe (p. 245, valeur choisie)" formula="1.5" name="#el_C"/>
        <variable description="Taille descendue du modèle souple (p. 247, lu sur le schéma)" formula="2" name="#desc_taille_pyj"/>
        <variable description="Largeur de l'élastique de taille (décision ; 4 au livre)" formula="3" name="#haut_elastique"/>
    </variables>

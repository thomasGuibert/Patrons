<?xml version='1.0' encoding='UTF-8'?>
<pattern>
    
    <version>0.7.4</version>
    <unit>cm</unit>
    <description />
    <notes />
    <patternLabel>
        <line alignment="1" bold="true" italic="false" sfIncrement="3" text="SWEAT HOMME" />
        <line alignment="4" bold="false" italic="true" sfIncrement="0" text="Encolure ronde, fentes, poche" />
        <line alignment="4" bold="false" italic="true" sfIncrement="0" text="T%size%" />
        <line alignment="4" bold="false" italic="false" sfIncrement="0" text="%pName%" />
    </patternLabel>
    <measurements>../mesures/homme/T44.smms</measurements>
    <variables>
        <variable description="Blousant de la manche au-dessus du poignet" formula="2" name="#blouse_manche" /><variable description="Côté avancé vers le devant au bas (lecture du dessin : fentes sur le devant)" formula="8" name="#avance_cote" /><variable description="Hauteur de fente au-dessus du bas du corps (le bord-côte s'ouvre aussi)" formula="5" name="#haut_fente" /><variable description="Réduction des bord-côtes : 3/4 de la ligne mesurée (livre, jogging fig. 3)" formula="3/4" name="#red_bc" /><variable description="Hauteur finie du bord-côte d'encolure" formula="2.5" name="#bc_encolure" /><variable description="Hauteur finie des poignets" formula="7" name="#bc_poignet" /><variable description="Hauteur finie du bord-côte de bas" formula="6" name="#bc_bas" /><variable description="Largeur de la poche poitrine" formula="12" name="#larg_poche" /><variable description="Hauteur finie de la poche sous le haut de poche" formula="10" name="#haut_poche" /><variable description="Hauteur finie du haut de poche (coupé double)" formula="5" name="#haut_haut_poche" /><variable description="Fraction du tour d'emmanchure pour la largeur AB (colonne anglaise du livre)" formula="3/4" name="#frac_largeur" />
        <variable description="Élargissement sweater : prolongement de l'épaule (p. 57, exemple)" formula="1.5" name="#el_epaule" />
        <variable description="Élargissement sweater : carrure (p. 57, exemple)" formula="1.5" name="#el_carrure" />
        <variable description="Élargissement sweater : descente de la ligne de carrure (p. 57, exemple)" formula="1.5" name="#desc_carrure" />
        <variable description="Élargissement sweater : dessous de bras vers l'extérieur (p. 57, exemple)" formula="3.5" name="#el_dessous_bras" />
        <variable description="Élargissement sweater : descente du dessous de bras (p. 57, exemple)" formula="3" name="#desc_dessous_bras" />
        <variable description="Élargissement sweater : bas (p. 57, exemple)" formula="2" name="#el_bas" />
        <variable description="Platitude d'emmanchure dos (p. 56)" formula="1" name="#plat_emm_dos" />
        <variable description="Platitude d'emmanchure devant (p. 56)" formula="1.5" name="#plat_emm_dev" />
        <variable description="Encolure sweater : dégagement du point d'encolure sur l'épaule (p. 57)" formula="3.5" name="#degag_epaule" />
        <variable description="Encolure sweater : descente du milieu dos (p. 57)" formula="2" name="#desc_dos" />
        <variable description="Encolure sweater : descente du milieu devant (p. 57)" formula="3.5" name="#desc_devant" />
        <variable description="Déplacement de la ligne d'épaule vers l'avant (p. 48)" formula="1.8" name="#decal_epaule" />
        <variable description="Creux de la tête de manche côté dos en G3 (1 au livre ; 3 pour un embu de 0,5 à 1 sur l'emmanchure sweater)" formula="3" name="#creux_tete_dos" />
        <variable description="Longueur de manche AC : bras + blousant, moins le prolongement d'épaule et le poignet" formula="arm_shoulder_tip_to_wrist+#blouse_manche-#el_epaule-#bc_poignet" name="#long_manche" />
        <variable description="Hauteur du coude AJ (proportion 35/60 du livre)" formula="#long_manche*35/60" name="#haut_coude" />
        <variable description="Aisance au bas de manche (froncé dans le poignet bord-côtes)" formula="8" name="#aisance_poignet" />
        <variable description="Largeur de bas de manche F1F2" formula="arm_wrist_circ+#aisance_poignet" name="#larg_bas" />
        </variables>

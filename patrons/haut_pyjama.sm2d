    <!--Pattern created with Seamly2D v2026.7.13.214 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>cm</unit>
    <description/>
    <notes/>
    <patternLabel>
        <line alignment="1" bold="true" italic="false" sfIncrement="3" text="HAUT DE PYJAMA"/>
        <line alignment="4" bold="false" italic="true" sfIncrement="0" text="T-shirt col V"/>
        <line alignment="4" bold="false" italic="true" sfIncrement="0" text="T%size%"/>
        <line alignment="4" bold="false" italic="false" sfIncrement="0" text="%pName%"/>
    </patternLabel>
    <measurements>../mesures/T44.smms</measurements>
    <variables>
        <variable description="Fraction du tour d'emmanchure pour la largeur AB (colonne anglaise du livre)" formula="3/4" name="#frac_largeur"/>
        <variable description="Longueur de manche AC" formula="arm_shoulder_tip_to_wrist" name="#long_manche"/>
        <variable description="Hauteur du coude AJ (proportion 35/60 du livre)" formula="#long_manche*35/60" name="#haut_coude"/>
        <variable description="Aisance au bas de manche" formula="2.8" name="#aisance_poignet"/>
        <variable description="Largeur de bas de manche F1F2" formula="arm_wrist_circ+#aisance_poignet" name="#larg_bas"/>
        <variable description="Élargissement T-shirt souple : prolongement de l'épaule (p. 56, exemple)" formula="0.5" name="#el_epaule"/>
        <variable description="Élargissement T-shirt souple : carrure (p. 56, exemple)" formula="0.5" name="#el_carrure"/>
        <variable description="Élargissement T-shirt souple : descente de la ligne de carrure (p. 56, exemple)" formula="0.75" name="#desc_carrure"/>
        <variable description="Élargissement T-shirt souple : dessous de bras vers l'extérieur (p. 56, exemple)" formula="1.5" name="#el_dessous_bras"/>
        <variable description="Élargissement T-shirt souple : descente du dessous de bras (p. 56, exemple)" formula="1.5" name="#desc_dessous_bras"/>
        <variable description="Élargissement T-shirt souple : taille (p. 56, exemple)" formula="0.5" name="#el_taille"/>
        <variable description="Élargissement T-shirt souple : bas (p. 56, exemple)" formula="1" name="#el_bas"/>
        <variable description="Platitude d'emmanchure dos (p. 56)" formula="1" name="#plat_emm_dos"/>
        <variable description="Platitude d'emmanchure devant (p. 56)" formula="1.5" name="#plat_emm_dev"/>
        <variable description="Encolure V : dégagement du point d'encolure sur l'épaule, ligne finie (exemple)" formula="3" name="#degag_epaule"/>
        <variable description="Encolure V : descente du milieu dos, ligne finie (exemple)" formula="2" name="#desc_dos"/>
        <variable description="Encolure V : descente du milieu devant, ligne finie (exemple)" formula="13" name="#desc_devant"/>
        <variable description="Largeur de la bande d'encolure finie (maximum du livre en jersey)" formula="1.5" name="#larg_bande"/>
        <variable description="Déplacement de la ligne d'épaule vers l'avant (p. 48)" formula="1.8" name="#decal_epaule"/>
        <variable description="Creux de la tête de manche côté dos en G3 (1 au livre ; 2 pour un embu de 0,5 à 1, décision 8)" formula="2" name="#creux_tete_dos"/>
        <variable description="Prolongement du milieu devant vers le bas (p. 60, 1 à 1,5)" formula="1.5" name="#prolong_devant"/>
    </variables>

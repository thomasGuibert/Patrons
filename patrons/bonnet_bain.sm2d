<point id="36" idObject="31" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="37" idObject="30" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="38" idObject="28" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="39" idObject="29" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="40" idObject="26" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/></modeling><pieces><piece id="23" name="Côté" seamAllowance="true" width="0.6" version="2" inLayout="true" united="false" locked="false" forbidFlipping="false" hideMainPath="false" color="#ffffff" fill="nobrush" mx="0" my="0"><data annotation="" foldPosition="" fontSize="0" height="3.3" letter="" mx="120.944" my="-317.478" onFold="false" orientation="Indéfini" quantity="2" rotation="0" rotationWay="Aucun" tilt="Aucun" visible="true" width="8"><line alignment="4" bold="true" italic="false" sfIncrement="3" text="%pName%"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="x%pQuantity% Tissu"/><line alignment="4" bold="false" italic="false" sfIncrement="0" text="Élasticité : sens de la largeur"/></data><patternInfo fontSize="0" height="3.3" mx="120.944" my="-185.196" rotation="0" visible="true" width="8"/><grainline arrowLength="1" arrows="0" length="7" mx="472.438" my="-45.354" rotation="90" visible="true"/><nodes><node idObject="12" type="NodePoint" before="1" after="0.6"/><node idObject="13" reverse="0" type="NodeSpline"/><node idObject="14" type="NodePoint" notch="true" notchType="vExternal" notchSubtype="straightforward" notchLength="0.5" notchWidth="0.5" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="15" reverse="0" type="NodeSpline"/><node idObject="16" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6" notchWidth="0.25" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="17" reverse="0" type="NodeSplinePath"/><node idObject="18" type="NodePoint" notch="true" notchType="vExternal" notchSubtype="straightforward" notchLength="0.5" notchWidth="0.5" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="19" reverse="0" type="NodeSplinePath"/><node idObject="20" type="NodePoint" notch="true" no
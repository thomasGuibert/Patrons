<?xml version="1.0" encoding="UTF-8"?>
<pattern>
<!--Généré par un script (issue #83, bonnet de bain), puis modifiable dans Seamly2D.-->
<version>0.7.4</version><unit>cm</unit><description/><notes/><patternLabel><line alignment="1" bold="true" italic="false" sfIncrement="3" text="BONNET DE BAIN"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="Taille unique"/><line alignment="4" bold="false" italic="false" sfIncrement="0" text="%pName%"/></patternLabel><measurements>../mesures/femme/T40.smms</measurements><variables><variable description="Taille unique : tour de tête moyen, le bonnet va de 52 à 60 cm grâce à la maille" formula="56" name="#tour_tete"/>
<variable description="Maille de bain (élasthanne) : bord de 49 cm, 94 % d'une tête de 52 et 82 % d'une tête de 60" formula="0.875" name="#reduction"/>
<variable description="Largeur de la bande centrale, du front à la nuque" formula="10" name="#larg_bande"/>
<variable description="Bas du côté : le tour du bord moins les deux bouts de bande, partagé entre les deux côtés" formula="(#tour_tete*#reduction-2*#larg_bande)/2" name="#bas_cote"/>
<variable description="Hauteur du côté, du bord au sommet (couture de bande)" formula="#tour_tete*0.19" name="#haut_cote"/>
<variable description="Cheveux longs : débord du côté en arrière de la nuque, pour loger les cheveux relevés" formula="4" name="#volume"/>
<variable description="Hauteur du point de volume arrière au-dessus du bord" formula="#haut_cote*0.45" name="#haut_volume"/>
<variable description="Sommet du côté depuis le front, sur le bas" formula="#bas_cote*0.4" name="#pos_sommet"/>
<variable description="Essayage (Thomas, 2026-11-14) : le bonnet s'arrêtait à la racine des cheveux, il descend 2 cm plus bas sur le front" formula="2" name="#rallonge_front"/></variables>
<draftBlock name="Bonnet de bain"><calculation><point id="1" name="A" type="single" mx="0.132292" my="0.264583" showPointName="true" x="0" y="0"/>
<point id="2" name="B" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="1" angle="0" length="#bas_cote" lineColor="black" lineType="dashLine" lineWeight="0.35"/>
<point id="3" name="S0" type="alongLine" mx="0.132292" my="0.264583" showPointName="true" firstPoint="1" secondPoint="2" length="#pos_sommet" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="4" name="S" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="3" angle="90" length="#haut_cote" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="5" name="R0" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="2" angle="0" length="#volume" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="6" name="R" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="5" angle="90" length="#haut_volume" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="7" name="F" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="1" angle="270" length="#rallonge_front" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<spline id="8" type="simpleInteractive" point1="7" point4="2" angle1="0" length1="#bas_cote*0.4" angle2="180" length2="#bas_cote*0.4" color="black" lineWeight="0.35" penStyle="solidLine"/>
<spline id="9" type="simpleInteractive" point1="1" point4="4" angle1="90" length1="#haut_cote*0.55" angle2="180" length2="#pos_sommet*0.6" color="black" lineWeight="0.35" penStyle="solidLine"/>
<spline id="10" type="pathInteractive" color="black" lineWeight="0.35" penStyle="solidLine"><pathPoint pSpline="4" angle1="(0)+180" length1="0" angle2="0" length2="(#bas_cote-#pos_sommet+#volume)*0.55"/><pathPoint pSpline="6" angle1="(270)+180" length1="(#haut_cote-#haut_volume)*0.6" angle2="270" length2="#haut_volume*0.5"/><pathPoint pSpline="2" angle1="(270)+180" length1="#haut_volume*0.6" angle2="270" length2="0"/></spline>
<point id="11" name="M1" type="cutSpline" mx="0.132292" my="0.264583" showPointName="true" spline="9" length="(#rallonge_front+Spl_A_S+SplPath_S_B)/4-#rallonge_front" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="12" name="M2" type="cutSplinePath" mx="0.132292" my="0.264583" showPointName="true" splinePath="10" length="(#rallonge_front+Spl_A_S+SplPath_S_B)/2-#rallonge_front-Spl_A_S" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="13" name="M3" type="cutSplinePath" mx="0.132292" my="0.264583" showPointName="true" splinePath="10" length="(#rallonge_front+Spl_A_S+SplPath_S_B)*3/4-#rallonge_front-Spl_A_S" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="28" name="bA" type="single" mx="0.132292" my="0.264583" showPointName="true" x="28" y="-16"/>
<point id="29" name="bB" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="28" angle="270" length="(#rallonge_front+Spl_A_S+SplPath_S_B)" lineColor="black" lineType="dashLine" lineWeight="0.35"/>
<point id="30" name="bA2" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="28" angle="180" length="#larg_bande/2" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="31" name="bB2" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="29" angle="180" length="#larg_bande/2" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="32" name="bS" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="30" angle="270" length="#rallonge_front+Spl_A_S" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="33" name="bM1" type="alongLine" mx="0.132292" my="0.264583" showPointName="true" firstPoint="30" secondPoint="31" length="(#rallonge_front+Spl_A_S+SplPath_S_B)/4" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="34" name="bM2" type="alongLine" mx="0.132292" my="0.264583" showPointName="true" firstPoint="30" secondPoint="31" length="(#rallonge_front+Spl_A_S+SplPath_S_B)/2" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="35" name="bM3" type="alongLine" mx="0.132292" my="0.264583" showPointName="true" firstPoint="30" secondPoint="31" length="(#rallonge_front+Spl_A_S+SplPath_S_B)*3/4" lineColor="black" lineType="none" lineWeight="0.35"/>
<line id="36" firstPoint="30" secondPoint="31" lineColor="black" lineType="solidLine" lineWeight="0.35"/></calculation><modeling><point id="14" idObject="7" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="15" idObject="1" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="16" idObject="9" inUse="true" type="modelingSpline"/>
<point id="17" idObject="11" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="18" idObject="9" inUse="true" type="modelingSpline"/>
<point id="19" idObject="4" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="20" idObject="10" inUse="true" type="modelingPath"/>
<point id="21" idObject="12" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="22" idObject="10" inUse="true" type="modelingPath"/>
<point id="23" idObject="13" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="24" idObject="10" inUse="true" type="modelingPath"/>
<point id="25" idObject="2" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="26" idObject="8" inUse="true" type="modelingSpline"/>
<point id="37" idObject="28" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="38" idObject="29" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="39" idObject="31" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="40" idObject="35" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="41" idObject="34" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="42" idObject="32" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="43" idObject="33" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="44" idObject="30" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/></modeling><pieces><piece id="27" name="Côté" seamAllowance="true" width="0.6" version="2" inLayout="true" united="false" locked="false" forbidFlipping="false" hideMainPath="false" color="#ffffff" fill="nobrush" mx="0" my="0"><data annotation="" foldPosition="" fontSize="0" height="2.6" letter="" mx="120.944" my="-302.360" onFold="false" orientation="Indéfini" quantity="2" rotation="0" rotationWay="Aucun" tilt="Aucun" visible="true" width="8"><line alignment="4" bold="true" italic="false" sfIncrement="3" text="%pName%"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="x%pQuantity% Tissu"/></data><patternInfo fontSize="0" height="2.6" mx="120.944" my="-188.975" rotation="0" visible="true" width="8"/><grainline arrowLength="1" arrows="0" length="11.5" mx="68.031" my="-45.354" rotation="0" visible="true"/><nodes><node idObject="14" type="NodePoint" before="1" after="0.6"/><node idObject="15" type="NodePoint"/><node idObject="16" reverse="0" type="NodeSpline"/><node idObject="17" type="NodePoint" notch="true" notchType="vInternal" notchSubtype="straightforward" notchLength="0.5" notchWidth="0.5" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="18" reverse="0" type="NodeSpline"/><node idObject="19" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6" notchWidth="0.25" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="20" reverse="0" type="NodeSplinePath"/><node idObject="21" type="NodePoint" notch="true" notchType="vInternal" notchSubtype="straightforward" notchLength="0.5" notchWidth="0.5" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="22" reverse="0" type="NodeSplinePath"/><node idObject="23" type="NodePoint" notch="true" notchType="vInternal" notchSubtype="straightforward" notchLength="0
<point id="47" name="Z1" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="46" angle="0" length="5" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="48" name="Z2" type="normal" mx="0.132292" my="0.264583" showPointName="true" firstPoint="47" secondPoint="46" length="5" angle="0" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="49" name="Z3" type="normal" mx="0.132292" my="0.264583" showPointName="true" firstPoint="48" secondPoint="47" length="5" angle="0" lineColor="black" lineType="solidLine" lineWeight="0.35"/>

<?xml version="1.0" encoding="UTF-8"?>
<pattern>
<!--Généré par un script (issue #83, bonnet de bain), puis modifiable dans Seamly2D.-->
<version>0.7.4</version><unit>cm</unit><description/><notes/><patternLabel><line alignment="1" bold="true" italic="false" sfIncrement="3" text="BONNET DE BAIN"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="T%size%"/><line alignment="4" bold="false" italic="false" sfIncrement="0" text="%pName%"/></patternLabel><measurements>../mesures/femme/T40.smms</measurements><variables><variable description="Maille de bain (élasthanne) : bord du bonnet 10 % plus court que le tour de tête, pour qu'il tienne" formula="0.9" name="#reduction"/>
<variable description="Largeur de la bande centrale, du front à la nuque" formula="10" name="#larg_bande"/>
<variable description="Bas du côté : le tour du bord moins les deux bouts de bande, partagé entre les deux côtés" formula="(head_circ*#reduction-2*#larg_bande)/2" name="#bas_cote"/>
<variable description="Hauteur du côté, du bord au sommet (couture de bande)" formula="head_circ*0.19" name="#haut_cote"/>
<variable description="Cheveux longs : débord du côté en arrière de la nuque, pour loger les cheveux relevés" formula="4" name="#volume"/>
<variable description="Hauteur du point de volume arrière au-dessus du bord" formula="#haut_cote*0.45" name="#haut_volume"/>
<variable description="Sommet du côté depuis le front, sur le bas" formula="#bas_cote*0.4" name="#pos_sommet"/></variables>
<draftBlock name="Bonnet de bain"><calculation><point id="1" name="A" type="single" mx="0.132292" my="0.264583" showPointName="true" x="0" y="0"/>
<point id="2" name="B" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="1" angle="0" length="#bas_cote" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="3" name="S0" type="alongLine" mx="0.132292" my="0.264583" showPointName="true" firstPoint="1" secondPoint="2" length="#pos_sommet" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="4" name="S" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="3" angle="90" length="#haut_cote" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="5" name="R0" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="2" angle="0" length="#volume" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="6" name="R" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="5" angle="90" length="#haut_volume" lineColor="black" lineType="none" lineWeight="0.35"/>
<spline id="7" type="simpleInteractive" point1="1" point4="4" angle1="90" length1="#haut_cote*0.55" angle2="180" length2="#pos_sommet*0.6" color="black" lineWeight="0.35" penStyle="solidLine"/>
<spline id="8" type="pathInteractive" color="black" lineWeight="0.35" penStyle="solidLine"><pathPoint pSpline="4" angle1="(0)+180" length1="0" angle2="0" length2="(#bas_cote-#pos_sommet+#volume)*0.55"/><pathPoint pSpline="6" angle1="(270)+180" length1="(#haut_cote-#haut_volume)*0.6" angle2="270" length2="#haut_volume*0.5"/><pathPoint pSpline="2" angle1="(270)+180" length1="#haut_volume*0.6" angle2="270" length2="0"/></spline>
<point id="15" name="bA" type="single" mx="0.132292" my="0.264583" showPointName="true" x="28" y="-16"/>
<point id="16" name="bB" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="15" angle="270" length="(Spl_A_S+SplPath_S_B)" lineColor="black" lineType="dashLine" lineWeight="0.35"/>
<point id="17" name="bA2" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="15" angle="0" length="#larg_bande/2" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="18" name="bB2" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="16" angle="0" length="#larg_bande/2" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="19" name="bS" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="17" angle="270" length="Spl_A_S" lineColor="black" lineType="none" lineWeight="0.35"/>
<line id="20" firstPoint="17" secondPoint="19" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<line id="21" firstPoint="19" secondPoint="18" lineColor="black" lineType="solidLine" lineWeight="0.35"/></calculation><modeling><point id="9" idObject="1" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="10" idObject="7" inUse="true" type="modelingSpline"/>
<point id="11" idObject="4" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<spline id="12" idObject="8" inUse="true" type="modelingPath"/>
<point id="13" idObject="2" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="22" idObject="15" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="23" idObject="17" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="24" idObject="19" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="25" idObject="18" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/>
<point id="26" idObject="16" inUse="true" type="modeling" mx="0.132292" my="0.264583" showPointName="true"/></modeling><pieces><piece id="14" name="Côté" seamAllowance="true" width="0.6" version="2" inLayout="true" united="false" locked="false" forbidFlipping="false" hideMainPath="false" color="#ffffff" fill="nobrush" mx="0" my="0"><data annotation="" foldPosition="" fontSize="0" height="2.6" letter="" mx="120.944" my="-317.478" onFold="false" orientation="Indéfini" quantity="2" rotation="0" rotationWay="Aucun" tilt="Aucun" visible="true" width="7"><line alignment="4" bold="true" italic="false" sfIncrement="3" text="%pName%"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="x%pQuantity% Tissu"/></data><patternInfo fontSize="0" height="3.4" mx="120.944" my="-196.534" rotation="0" visible="true" width="7"/><grainline arrowLength="1" arrows="0" length="7" mx="472.438" my="-45.354" rotation="90" visible="true"/><nodes><node idObject="9" type="NodePoint" before="1" after="0.6"/><node idObject="10" reverse="0" type="NodeSpline"/><node idObject="11" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6" notchWidth="0.25" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="12" reverse="0" type="NodeSplinePath"/><node idObject="13" type="NodePoint" before="0.6" after="1"/></nodes></piece>
<piece id="27" name="Bande centrale" seamAllowance="true" width="0.6" version="2" inLayout="true" united="false" locked="false" forbidFlipping="false" hideMainPath="false" color="#ffffff" fill="nobrush" mx="0" my="0"><data annotation="" foldPosition="" fontSize="0" height="3.2" letter="" mx="1069.599" my="-472.438" onFold="true" orientation="Indéfini" quantity="1" rotation="0" rotationWay="Aucun" tilt="Aucun" visible="true" width="4.4"><line alignment="4" bold="true" italic="false" sfIncrement="3" text="%pName%"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="x%pQuantity% Tissu, au pli"/></data><patternInfo fontSize="0" height="4" mx="1069.599" my="-321.257" rotation="0" visible="true" width="4.4"/><grainline arrowLength="1" arrows="0" length="8" mx="1152.747" my="491.335" rotation="90" visible="true"/><nodes><node idObject="22" type="NodePoint" before="0" after="1"/><node idObject="23" type="NodePoint" before="1" after="0.6"/><node idObject="24" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6" notchWidth="0.25" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="25" type="NodePoint" before="0.6" after="1"/><node idObject="26" type="NodePoint" before="1" after="0"/></nodes></piece></pieces><groups/><images/></draftBlock>
</pattern>

<piece id="45" name="Bande centrale" seamAllowance="true" width="0.6" version="2" inLayout="true" united="false" locked="false" forbidFlipping="false" hideMainPath="false" color="#ffffff" fill="nobrush" mx="0" my="0"><data annotation="" foldPosition="" fontSize="0" height="4.4" letter="" mx="880.624" my="-472.438" onFold="true" orientation="Indéfini" quantity="1" rotation="0" rotationWay="Aucun" tilt="Aucun" visible="true" width="4.4"><line alignment="4" bold="true" italic="false" sfIncrement="3" text="%pName%"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="x%pQuantity% Tissu, au pli"/></data><patternInfo fontSize="0" height="4" mx="880.624" my="-347.714" rotation="0" visible="true" width="4.4"/><grainline arrowLength="1" arrows="0" length="4" mx="888.183" my="-226.770" rotation="0" visible="true"/><nodes><node idObject="37" type="NodePoint" before="1" after="0"/><node idObject="38" type="NodePoint" before="0" after="1"/><node idObject="39" type="NodePoint" before="1" after="0.6"/><node idObject="40" type="NodePoint" notch="true" notchType="vInternal" notchSubtype="straightforward" notchLength="0.5" notchWidth="0.5" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="41" type="NodePoint" notch="true" notchType="vInternal" notchSubtype="straightforward" notchLength="0.5" notchWidth="0.5" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="42" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6" notchWidth="0.25" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="43" type="NodePoint" notch="true" notchType="vInternal" notchSubtype="straightforward" notchLength="0.5" notchWidth="0.5" notchAngle="0" notchCount="1" showNotch="true" showSecondNotch="true"/><node idObject="44" type="NodePoint" before="0.6" after="1"/></nodes></piece></pieces><groups/><images/></draftBlock>

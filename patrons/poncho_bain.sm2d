<point id="11" name="Ou1" type="alongLine" mx="0.132292" my="0.264583" showPointName="true" firstPoint="7" secondPoint="9" length="#ouv_haut-#pente-#emman" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="12" name="Ou2" type="alongLine" mx="0.132292" my="0.264583" showPointName="true" firstPoint="7" secondPoint="9" length="#ouv_haut-#pente-#emman+#ouv_long" lineColor="black" lineType="none" lineWeight="0.35"/>
<spline id="13" type="simpleInteractive" point1="2" point4="3" angle1="0" length1="#larg_enc*0.6" angle2="AngleLine_E_Ep-90" length2="#prof_enc_dev*0.55" color="black" lineWeight="0.35" penStyle="solidLine"/>
<point id="14" name="Cn" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="2" angle="270" length="#long_normal+#ourlet-#prof_enc_dev" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="15" name="Cns" type="lineIntersectAxis" mx="0.132292" my="0.264583" showPointName="true" basePoint="14" angle="0" p1Line="7" p2Line="9" lineColor="black" lineType="none" lineWeight="0.35"/>

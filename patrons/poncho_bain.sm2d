<?xml version="1.0" encoding="UTF-8"?>
<pattern>
<!--Généré par un script (issue #89, poncho de bain), puis modifiable dans Seamly2D.-->
<version>0.7.4</version><unit>cm</unit><description/><notes/><patternLabel><line alignment="1" bold="true" italic="false" sfIncrement="3" text="PONCHO DE BAIN"/><line alignment="4" bold="false" italic="true" sfIncrement="0" text="T%size%"/><line alignment="4" bold="false" italic="false" sfIncrement="0" text="%pName%"/></patternLabel><measurements>../mesures/femme/T40.smms</measurements><variables><variable description="Le plus fort des tours de poitrine et de hanches" formula="(bust_circ+hip_circ)/2+abs(hip_circ-bust_circ)/2" name="#tour_max"/>
<variable description="Aisance du poncho : de quoi se changer dessous, bras rentrés" formula="64" name="#aisance"/>
<variable description="Demi-largeur du devant (et du dos) en haut, au pli" formula="(#tour_max+#aisance)/4" name="#demi_larg"/>
<variable description="Évasement du côté, du dessous de bras au bas" formula="4" name="#evase"/>
<variable description="Pente d'épaule, de l'encolure au bord du devant" formula="3" name="#pente"/>
<variable description="Demi-largeur d'encolure, élargie pour la capuche" formula="neck_circ/6+2.5" name="#larg_enc"/>
<variable description="Profondeur d'encolure devant" formula="neck_circ/6+4" name="#prof_enc_dev"/>
<variable description="Profondeur d'encolure dos" formula="4.5" name="#prof_enc_dos"/>
<variable description="Hauteur de l'emmanchure sur le côté : la demi-largeur de manche" formula="bust_circ/8+13.5" name="#emman"/>
<variable description="Du bout d'épaule au coude" formula="arm_shoulder_tip_to_wrist*0.55" name="#long_coude"/>
<variable description="Manche : du bord du devant au coude, le devant couvrant déjà le haut du bras" formula="#long_coude+2-(#demi_larg-#larg_enc-shoulder_length)" name="#long_manche"/>
<variable description="La manche se resserre un peu au coude (sur la demi-largeur)" formula="2" name="#resserre"/>
<variable description="De la nuque au genou" formula="height_neck_back-height_waist_side+height_waist_side_to_knee" name="#long_genou"/>
<variable description="Longueur petit : mi-cuisse" formula="#long_genou-22" name="#long_petit"/>
<variable description="Longueur normal : au-dessus du genou" formula="#long_genou-8" name="#long_normal"/>
<variable description="Longueur grand : sous le genou" formula="#long_genou+8" name="#long_grand"/>
<variable description="Ourlet du bas" formula="3" name="#ourlet"/>
<variable description="Haut de l'ouverture de côté, depuis l'épaule" formula="neck_back_to_waist_b-4" name="#ouv_haut"/>
<variable description="Longueur de l'ouverture de côté, pour passer les mains" formula="24" name="#ouv_long"/>
<variable description="Haut de la poche kangourou, depuis l'épaule" formula="neck_back_to_waist_b+1" name="#poche_y"/>
<variable description="Hauteur de la poche" formula="26" name="#poche_h"/>
<variable description="Demi-largeur de la poche, en bas" formula="#demi_larg*0.5" name="#poche_demi"/>
<variable description="Demi-largeur du haut de la poche, entre les deux entrées de mains" formula="#poche_demi*0.6" name="#poche_haut_demi"/>
<variable description="Hauteur des entrées de mains, en biais" formula="17" name="#poche_ouv"/>
<variable description="Hauteur de capuche, de l'encolure au sommet" formula="height*0.21" name="#haut_cap"/>
<variable description="Profondeur de capuche, du bord du visage à l'arrière de la tête" formula="neck_circ*0.75" name="#prof_cap"/></variables>
<draftBlock name="Poncho de bain"><calculation><point id="1" name="O" type="single" mx="0.132292" my="0.264583" showPointName="true" x="0" y="0"/>
<point id="2" name="Fn" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="1" angle="270" length="#prof_enc_dev" lineColor="black" lineType="dashLine" lineWeight="0.35"/>
<point id="3" name="E" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="1" angle="0" length="#larg_enc" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="4" name="X" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="1" angle="0" length="#demi_larg" lineColor="black" lineType="none" lineWeight="0.35"/>
<point id="5" name="Ep" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="4" angle="270" length="#pente" lineColor="black" lineType="none" lineWeight="0.35"/>
<line id="6" firstPoint="3" secondPoint="5" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="7" name="Em" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="5" angle="270" length="#emman" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
<point id="8" name="Hc" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="2" angle="270" length="#long_grand-#prof_enc_dev" lineColor="black" lineType="dashLine" lineWeight="0.35"/>
<point id="9" name="H" type="endLine" mx="0.132292" my="0.264583" showPointName="true" basePoint="8" angle="0" length="#demi_larg+#evase" lineColor="black" lineType="solidLine" lineWeight="0.35"/>
